<script is:inline>
  (function () {
    if (typeof window !== "undefined") {
      const isSystemColorSchemeDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const storageTheme = sessionStorage.getItem("theme");
      const themeColorMetaTag = document.head.querySelector('meta[name="theme-color"]');
      const appStoreLink = document.getElementById("app-store-link");

      function setDarkMode() {
        document.documentElement.classList.add("dark");
        if (themeColorMetaTag) {
          themeColorMetaTag.content = "#0e141b";
        }
      }

      function setLightMode() {
        document.documentElement.classList.remove("dark");
        if (themeColorMetaTag) {
          themeColorMetaTag.content = "#ffffff";
        }
      }

      if (!storageTheme && isSystemColorSchemeDark) {
        setDarkMode();
      } else if (storageTheme === "dark") {
        setDarkMode();
      } else {
        setLightMode();
      }

      // Add event listener to toggle button
      const toggleButton = document.getElementById("mode-toggle");
      toggleButton.addEventListener("click", () => {
        if (document.documentElement.classList.contains("dark")) {
          setLightMode();
          sessionStorage.setItem("theme", "light");
        } else {
          setDarkMode();
          sessionStorage.setItem("theme", "dark");
        }
      });
    }
  })();
</script> 
 
