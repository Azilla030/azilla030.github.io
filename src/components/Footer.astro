---
import HeaderLink from "./HeaderLink.astro";
---
<footer class="text-white py-8 border-t border-gray-700">
  <div class="container mx-auto flex flex-col md:flex-row justify-between items-center px-4 md:px-8">
    <div class="flex flex-col items-start md:items-center">
        <ul class="unset flex gap-4 [&>li]:p-0">
          <li>
            <HeaderLink href="/privacy-policy" class="">Privacy Policy</HeaderLink>
          </li>
        </ul>
    </div>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: rgb(var(--color-bg-body));
    color: rgb(var(--color-text-body));
  }

  footer a {
    color: rgb(var(--color-text-link));
  }

  footer a:hover {
    color: rgb(var(--color-text-link));
  }

  footer .border-t {
    border-color: rgb(var(--color-border-code));
  }

  footer button {
    border-color: rgb(var(--color-border-code));
  }
</style>
