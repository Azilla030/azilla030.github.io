---
import DarkModeToggle from './DarkModeToggle.astro';
import HeaderLink from "./HeaderLink.astro";
---
<header class="grid grid-cols-[1fr_auto_1fr] items-center py-4">
  <nav class="flex items-center justify-start">
    <!-- Deine Navigationslinks oder Inhalte hier -->
    <ul class="unset flex gap-4 [&>li]:p-0">
      <li><HeaderLink href="/">Home</HeaderLink></li>
      <li><HeaderLink href="mailto:azilla91@gmail.com">Kontakt</HeaderLink></li>
      <li><HeaderLink href="/impressum">Impressum</HeaderLink></li>
    </ul>
   
    
  </nav>
  <div class="flex justify-center">
    <img src="/images/AppIcon.png" alt="Spiel Logo" class="h-8">
  </div>
  <div class="flex justify-end items-center">
    <div class="max-[375px]:hidden flex items-center content-center">
      <DarkModeToggle />
    </div>
  </div>
</header>

<style>
  header {
    grid-area: header;
    display: grid;
    align-items: center;
    grid-template-columns: 1fr auto 1fr;
  }
</style>
