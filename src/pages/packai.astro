---
// src/pages/packai.astro
export interface Props {
    title?: string;
}

const { title = "PackAI - On-Device Packing & Lists" } = Astro.props;
---

<html lang="de">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Die intelligente Packlisten-App mit KI-Chatbot. Verwende Apple's VisionKit zur Foto-Erkennung und lass dir von der KI beim Packen helfen." />
</head>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.6;
    color: #333;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

header {
    padding: 20px 0;
    position: relative;
    z-index: 100;
}

.header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    display: flex;
    align-items: center;
    gap: 15px;
}

.logo-icon {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #8b5cf6, #7c3aed);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: white;
    font-weight: bold;
    box-shadow: 0 8px 25px rgba(139, 92, 246, 0.3);
    background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect x="20" y="25" width="60" height="45" rx="8" ry="8" fill="white" stroke="none"/><rect x="25" y="30" width="50" height="15" rx="3" ry="3" fill="%238b5cf6" stroke="none"/><rect x="25" y="50" width="50" height="15" rx="3" ry="3" fill="%238b5cf6" stroke="none"/><path d="M35 15 L45 15 L50 25 L30 25 Z" fill="white" stroke="none"/><path d="M55 15 L65 15 L70 25 L50 25 Z" fill="white" stroke="none"/></svg>');
    background-size: 80%;
    background-repeat: no-repeat;
    background-position: center;
}

.logo h1 {
    color: white;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.5px;
}

.nav {
    display: flex;
    gap: 30px;
    align-items: center;
}

.nav a {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s ease;
}

.nav a:hover {
    color: white;
}

.language-selector {
    position: relative;
}

.language-selector select {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    cursor: pointer;
    backdrop-filter: blur(10px);
}

.language-selector select option {
    background: #2d3748;
    color: white;
}

.hero {
    text-align: center;
    padding: 80px 0 120px;
    color: white;
    position: relative;
}

.hero-content {
    max-width: 800px;
    margin: 0 auto;
}

.hero h2 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    margin-bottom: 20px;
    line-height: 1.2;
    background: linear-gradient(135deg, #fff, #e0e7ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-subtitle {
    font-size: 1.3rem;
    margin-bottom: 40px;
    opacity: 0.95;
    font-weight: 400;
}

.hero-description {
    font-size: 1.1rem;
    margin-bottom: 50px;
    opacity: 0.9;
    line-height: 1.7;
}

.app-store-btn {
    display: inline-block;
    transition: transform 0.3s ease, opacity 0.3s ease;
    border-radius: 8px;
    overflow: hidden;
}

.app-store-btn:hover {
    transform: translateY(-2px) scale(1.05);
    opacity: 0.9;
}

.scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    opacity: 0;
    animation: fadeInBounce 3s ease-in-out infinite;
    cursor: pointer;
    transition: opacity 0.3s ease;
}

.scroll-mouse {
    width: 24px;
    height: 40px;
    border: 2px solid rgba(255, 255, 255, 0.8);
    border-radius: 15px;
    position: relative;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
}

.scroll-wheel {
    width: 4px;
    height: 8px;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 2px;
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    animation: scrollWheel 2s ease-in-out infinite;
}

.scroll-text {
    color: rgba(255, 255, 255, 0.8);
    font-size: 12px;
    margin-top: 10px;
    text-align: center;
    font-weight: 500;
    letter-spacing: 0.5px;
}

.features {
    background: white;
    padding: 100px 0;
    position: relative;
}

.features::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 calc(100% - 40px));
}

.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 50px;
    margin-top: 50px;
}

.features h3 {
    text-align: center;
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 20px;
    color: #2d3748;
}

.features-intro {
    text-align: center;
    font-size: 1.2rem;
    color: #666;
    max-width: 600px;
    margin: 0 auto 60px;
}

.feature-card {
    background: white;
    padding: 40px 30px;
    border-radius: 20px;
    text-align: center;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid #f0f4f8;
    opacity: 0;
    transform: translateY(30px);
}

.feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
}

.feature-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 25px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36px;
    color: white;
    background: linear-gradient(135deg, #667eea, #764ba2);
}

.feature-card h4 {
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 15px;
    color: #2d3748;
}

.feature-card p {
    color: #666;
    line-height: 1.6;
}

.privacy-section {
    background: linear-gradient(135deg, #1a202c, #2d3748);
    color: white;
    padding: 100px 0;
    text-align: center;
}

.privacy-content {
    max-width: 700px;
    margin: 0 auto;
}

.privacy-section h3 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 30px;
}

.privacy-section p {
    font-size: 1.2rem;
    margin-bottom: 25px;
    opacity: 0.9;
    line-height: 1.7;
}

.privacy-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
    margin-top: 50px;
}

.privacy-feature {
    padding: 20px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 15px;
    backdrop-filter: blur(10px);
}

.privacy-feature-icon {
    font-size: 32px;
    margin-bottom: 15px;
}

footer {
    background: #1a202c;
    color: white;
    padding: 50px 0;
    text-align: center;
}

.footer-content {
    margin-bottom: 30px;
}

.footer-content a {
    color: #a0aec0;
    text-decoration: none;
    margin: 0 30px;
    transition: color 0.3s ease;
}

.footer-content a:hover {
    color: white;
}

.footer-bottom {
    border-top: 1px solid #2d3748;
    padding-top: 30px;
    color: #a0aec0;
}

.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.8);
    z-index: 1000;
    align-items: center;
    justify-content: center;
}

.modal-content {
    background: white;
    padding: 40px;
    border-radius: 20px;
    max-width: 500px;
    margin: 20px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.modal-close {
    background: none;
    border: none;
    font-size: 24px;
    cursor: pointer;
    color: #666;
}

.modal-body {
    color: #666;
    line-height: 1.6;
}

@keyframes fadeInBounce {
    0%, 20% {
        opacity: 0;
        transform: translateX(-50%) translateY(10px);
    }
    30%, 70% {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }
    80%, 100% {
        opacity: 0;
        transform: translateX(-50%) translateY(-10px);
    }
}

@keyframes scrollWheel {
    0% {
        top: 8px;
        opacity: 1;
    }
    50% {
        top: 18px;
        opacity: 0.5;
    }
    100% {
        top: 26px;
        opacity: 0;
    }
}

@media (max-width: 768px) {
    .header-content {
        flex-direction: column;
        gap: 20px;
    }

    .nav {
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero {
        padding: 50px 0 80px;
    }

    .features {
        padding: 80px 0;
    }

    .features-grid {
        grid-template-columns: 1fr;
        gap: 40px;
    }

    .privacy-features {
        grid-template-columns: 1fr;
    }
}
</style>

<body>
    <header>
        <div class="container">
            <div class="header-content">
                <div class="logo">
                    <div class="logo-icon"></div>
                    <h1>PackAI</h1>
                </div>
                <nav class="nav">
                    <a href="#features" data-i18n="nav.features">Features</a>
                    <a href="#privacy" data-i18n="nav.privacy">Privacy</a>
                    <a href="mailto:support@reyescasa.games" data-i18n="nav.support">Support</a>
                    <div class="language-selector">
                        <select id="languageSelect">
                            <option value="de">🇩🇪 DE</option>
                            <option value="en">🇺🇸 EN</option>
                        </select>
                    </div>
                </nav>
            </div>
        </div>
    </header>

    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <h2>On-Device Packing & Lists</h2>
                <p class="hero-subtitle" data-i18n="hero.subtitle">Die intelligente Packlisten-App mit KI-Chatbot</p>
                <p class="hero-description" data-i18n="hero.description">
                    Verwende Apple's VisionKit, um Gegenstände aus deinen Fotos zu extrahieren.
                    Organisiere sie in Packlisten und plane Reisen mit Leichtigkeit.<br>
                    <strong>NEU:</strong> Intelligenter Chatbot hilft dir bei der Auswahl der perfekten Gegenstände für jede Reise.<br>
                    Alles läuft vollständig auf deinem Gerät — keine APIs, keine Datensammlung.
                </p>
                <a href="https://apps.apple.com/app/packai/id6745692929" class="app-store-btn" id="appStoreBtn">
                    <img id="appStoreBadge" src="/images/Download_on_the_App_Store_DE_blk.svg" alt="Download on the App Store" style="height: 60px; width: auto;">
                </a>
            </div>
        </div>
        <div class="scroll-indicator" id="scrollIndicator">
            <div class="scroll-mouse">
                <div class="scroll-wheel"></div>
            </div>
            <div class="scroll-text" data-i18n="scroll">Scroll</div>
        </div>
    </section>

    <section class="features" id="features">
        <div class="container">
            <h3 data-i18n="features.title">Warum PackAI?</h3>
            <p class="features-intro" data-i18n="features.intro">
                Eine revolutionäre Art des Packens, die KI, Technologie und Einfachheit vereint
            </p>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">🤖</div>
                    <h4 data-i18n="features.cards.0.title">KI-Chatbot für intelligentes Packen</h4>
                    <p data-i18n="features.cards.0.description">Intelligenter Chatbot analysiert deine Reise und empfiehlt die perfekten Gegenstände. Frag einfach: "Was soll ich für meinen Strandurlaub einpacken?" - komplett offline auf deinem Gerät.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📸</div>
                    <h4 data-i18n="features.cards.1.title">Foto-Erkennung</h4>
                    <p data-i18n="features.cards.1.description">Nutze Apple's VisionKit zur automatischen Erkennung von Gegenständen in deinen Fotos. Einfach fotografieren und fertig!</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🎯</div>
                    <h4 data-i18n="features.cards.2.title">Intelligente Listen</h4>
                    <p data-i18n="features.cards.2.description">Erstelle maßgeschneiderte Packlisten für jeden Anlass - vom Geschäftstermin bis zum Wanderurlaub.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">📱</div>
                    <h4 data-i18n="features.cards.3.title">Komplett Offline</h4>
                    <p data-i18n="features.cards.3.description">Funktioniert vollständig auf deinem Gerät. Keine Internetverbindung nötig, keine Daten werden übertragen.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">⚡</div>
                    <h4 data-i18n="features.cards.4.title">Blitzschnell & Smart</h4>
                    <p data-i18n="features.cards.4.description">Leichtgewichtige App mit KI-Power, die deinen Akku schont und eine saubere, intuitive Benutzeroberfläche bietet.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🔄</div>
                    <h4 data-i18n="features.cards.5.title">Wiederverwendbar</h4>
                    <p data-i18n="features.cards.5.description">Speichere deine Listen und verwende sie für ähnliche Reisen wieder. Perfekt für Geschäftsreisende.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">🧠</div>
                    <h4 data-i18n="features.cards.6.title">Smarte Pack-Empfehlungen</h4>
                    <p data-i18n="features.cards.6.description">Der integrierte Chatbot lernt deine Reisegewohnheiten und schlägt die passenden Gegenstände für jeden Trip-Typ vor.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">👨‍👩‍👧‍👦</div>
                    <h4 data-i18n="features.cards.7.title">Für jeden Reisetyp</h4>
                    <p data-i18n="features.cards.7.description">Ob Familienurlaub, Geschäftsreise oder Abenteuertrip - der KI-Chatbot kennt die passenden Gegenstände für jeden Anlass.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="privacy-section" id="privacy">
        <div class="container">
            <div class="privacy-content">
                <h3 data-i18n="privacy.title">Deine Privatsphäre ist geschützt</h3>
                <p data-i18n="privacy.description1">
                    Im Gegensatz zu anderen Apps läuft PackAI vollständig lokal auf deinem Gerät.
                    Deine Fotos, Packlisten und Chatbot-Gespräche verlassen niemals dein iPhone!
                </p>
                <p data-i18n="privacy.description2">
                    Keine Cloud-Synchronisation, keine Server, keine Datensammlung.
                    100% private Pack-Beratung und KI-Unterstützung garantiert - alles auf deinem Gerät verarbeitet.
                </p>
                <div class="privacy-features">
                    <div class="privacy-feature">
                        <div class="privacy-feature-icon">🔒</div>
                        <h4 data-i18n="privacy.features.0.title">Offline KI</h4>
                        <p data-i18n="privacy.features.0.description">Chatbot arbeitet lokal</p>
                    </div>
                    <div class="privacy-feature">
                        <div class="privacy-feature-icon">🛡️</div>
                        <h4 data-i18n="privacy.features.1.title">Zero Tracking</h4>
                        <p data-i18n="privacy.features.1.description">Keine Pack-Daten-Sammlung</p>
                    </div>
                    <div class="privacy-feature">
                        <div class="privacy-feature-icon">📱</div>
                        <h4 data-i18n="privacy.features.2.title">On-Device</h4>
                        <p data-i18n="privacy.features.2.description">Komplette Verarbeitung lokal</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <div class="container">
            <div class="footer-content">
                <a href="mailto:support@reyescasa.games" data-i18n="nav.support">Support</a>
                <a href="#impressum" id="impressumLink">Impressum</a>
            </div>
            <div class="footer-bottom">
                <p data-i18n="footer.copyright">&copy; 2025 Reyes Casa Games. Alle Rechte vorbehalten.</p>
            </div>
        </div>
    </footer>

    <!-- Impressum Modal -->
    <div id="impressum-modal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Impressum</h3>
                <button class="modal-close" id="modalClose">&times;</button>
            </div>
            <div class="modal-body">
                <strong>Reyes Casa Games</strong><br>
                c/o IP-Management #36237<br>
                Ludwig-Erhard-Str. 18<br>
                20459 Hamburg<br>
                Deutschland
            </div>
        </div>
    </div>

    <script>
        const translations = {
            de: {
                "nav.features": "Features",
                "nav.privacy": "Privacy",
                "nav.support": "Support",
                "hero.subtitle": "Die intelligente Packlisten-App mit KI-Chatbot",
                "hero.description": "Verwende Apple's VisionKit, um Gegenstände aus deinen Fotos zu extrahieren. Organisiere sie in Packlisten und plane Reisen mit Leichtigkeit.<br><strong>NEU:</strong> Intelligenter Chatbot hilft dir bei der Auswahl der perfekten Gegenstände für jede Reise.<br>Alles läuft vollständig auf deinem Gerät — keine APIs, keine Datensammlung.",
                "features.title": "Warum PackAI?",
