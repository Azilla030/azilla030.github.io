                "scroll": "Scroll"
            },
            en: {
                "nav.features": "Features",
                "nav.privacy": "Privacy",
                "nav.support": "Support",
                "hero.subtitle": "The smart packing list app with AI chatbot",
                "hero.description": "Use Apple's VisionKit to extract items from your photos. Organize them into packing lists and plan trips with ease.<br><strong>NEW:</strong> Intelligent chatbot helps you choose the perfect items for every trip.<br>Everything runs entirely on your device — no APIs, zero data collection.",
                "features.title": "Why PackAI?",
                "features.intro": "A revolutionary way of packing that combines AI, technology and simplicity",
                "features.cards.0.title": "AI Chatbot for Smart Packing",
                "features.cards.0.description": "Intelligent chatbot analyzes your trip and recommends the perfect items. Just ask: \"What should I pack for my beach vacation?\" - completely offline on your device.",
                "features.cards.1.title": "Photo Recognition",
                "features.cards.1.description": "Use Apple's VisionKit for automatic item recognition from your photos. Simply take a photo and you're done!",
