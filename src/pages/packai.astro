        let currentLanguage = 'de';

        function changeLanguage(lang) {
            currentLanguage = lang;
            const t = translations[lang];
            if (!t) return;

            document.querySelectorAll('[data-i18n]').forEach(element => {
                const key = element.getAttribute('data-i18n');
                if (t[key]) {
                    if (t[key].includes('<br>') || t[key].includes('<strong>')) {
                        element.innerHTML = t[key];
                    } else {
                        element.textContent = t[key];
                    }
                }
            });

            // Update App Store badge based on language
            const appStoreBadge = document.getElementById('appStoreBadge');
            if (appStoreBadge) {
                if (lang === 'de') {
                    appStoreBadge.src = '/images/Download_on_the_App_Store_DE_blk.svg';
                    appStoreBadge.alt = 'Im App Store laden';
                } else {
                    appStoreBadge.src = '/images/Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg';
                    appStoreBadge.alt = 'Download on the App Store';
                }
            }

            document.title = lang === 'de' ? 'PackAI - On-Device Packing & Lists' : 'PackAI - On-Device Packing & Lists';
        }

        function scrollToFeatures() {
            document.querySelector('#features').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }


        document.addEventListener('DOMContentLoaded', function() {
            const languageSelect = document.getElementById('languageSelect');
            languageSelect.addEventListener('change', function() {
                changeLanguage(this.value);
            });

            const scrollIndicator = document.getElementById('scrollIndicator');
            scrollIndicator.addEventListener('click', scrollToFeatures);


            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            let scrollTimeout;
            window.addEventListener('scroll', () => {
                const scrolled = window.pageYOffset;
                const hero = document.querySelector('.hero');
                const scrollIndicator = document.querySelector('.scroll-indicator');

                const parallax = scrolled * 0.3;
                hero.style.transform = `translateY(${parallax}px)`;

                if (scrolled > 50) {
                    scrollIndicator.style.opacity = '0';
                } else {
                    scrollIndicator.style.opacity = '1';
                }
            });

            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                        entry.target.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                    }
                });
            }, observerOptions);

            document.querySelectorAll('.feature-card').forEach(card => {
                observer.observe(card);
            });

            // Privacy Policy Modal functionality
            const privacyPolicyLink = document.getElementById('privacyPolicyLink');
            const privacyModal = document.getElementById('privacyModal');
            const closePrivacy = document.getElementById('closePrivacy');

            privacyPolicyLink.addEventListener('click', function(e) {
                e.preventDefault();
                privacyModal.style.display = 'flex';
            });

            closePrivacy.addEventListener('click', function() {
                privacyModal.style.display = 'none';
            });

            // Close modal when clicking outside
            privacyModal.addEventListener('click', function(e) {
                if (e.target === privacyModal) {
                    privacyModal.style.display = 'none';
                }
            });

            // Close modal with Escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && privacyModal.style.display === 'flex') {
                    privacyModal.style.display = 'none';
                }
            });
        });
    </script>
</body>
