                "features.cards.5.description": "Save your lists and reuse them for similar trips. Perfect for business travelers.",
                "features.cards.6.title": "Smart Pack Recommendations",
                "features.cards.6.description": "The integrated chatbot learns your travel habits and suggests the right items for every trip type.",
                "features.cards.7.title": "For Every Trip Type",
                "features.cards.7.description": "Whether family vacation, business trip or adventure trip - the AI chatbot knows the right items for every occasion.",
                "privacy.title": "Your Privacy is Protected",
                "privacy.description1": "Unlike other apps, PackAI runs entirely locally on your device. Your photos, packing lists and chatbot conversations never leave your iPhone!",
                "privacy.description2": "No cloud sync, no servers, no data collection. 100% private packing advice and AI support guaranteed - everything processed on your device.",
                "privacy.features.0.title": "Offline AI",
                "privacy.features.0.description": "Chatbot works locally",
                "privacy.features.1.title": "Zero Tracking",
                "privacy.features.1.description": "No pack data collection",
                "privacy.features.2.title": "On-Device",
                "privacy.features.2.description": "Complete local processing",
                "footer.copyright": "© 2025 Reyes Casa Games. All rights reserved.",
                "scroll": "Scroll"
            }
        };

        let currentLanguage = 'de';

        function changeLanguage(lang) {
            currentLanguage = lang;
            const t = translations[lang];
            if (!t) return;

            document.querySelectorAll('[data-i18n]').forEach(element => {
                const key = element.getAttribute('data-i18n');
                if (t[key]) {
                    if (t[key].includes('<br>') || t[key].includes('<strong>')) {
                        element.innerHTML = t[key];
                    } else {
                        element.textContent = t[key];
                    }
                }
            });

            // Update App Store badge based on language
            const appStoreBadge = document.getElementById('appStoreBadge');
            if (appStoreBadge) {
                if (lang === 'de') {
                    appStoreBadge.src = '/images/Download_on_the_App_Store_DE_blk.svg';
                    appStoreBadge.alt = 'Im App Store laden';
                } else {
                    appStoreBadge.src = '/images/Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg';
                    appStoreBadge.alt = 'Download on the App Store';
                }
            }

            document.title = lang === 'de' ? 'PackAI - On-Device Packing & Lists' : 'PackAI - On-Device Packing & Lists';
        }

        function scrollToFeatures() {
            document.querySelector('#features').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }

        function showImpressum() {
            const modal = document.getElementById('impressum-modal');
            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function hideImpressum() {
            const modal = document.getElementById('impressum-modal');
            modal.style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        document.addEventListener('DOMContentLoaded', function() {
            const languageSelect = document.getElementById('languageSelect');
            languageSelect.addEventListener('change', function() {
                changeLanguage(this.value);
            });

            const scrollIndicator = document.getElementById('scrollIndicator');
            scrollIndicator.addEventListener('click', scrollToFeatures);

            const impressumLink = document.getElementById('impressumLink');
            const modalClose = document.getElementById('modalClose');
            const modal = document.getElementById('impressum-modal');

            impressumLink.addEventListener('click', function(e) {
                e.preventDefault();
                showImpressum();
            });

            modalClose.addEventListener('click', hideImpressum);

            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    hideImpressum();
                }
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    hideImpressum();
                }
            });

            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            let scrollTimeout;
            window.addEventListener('scroll', () => {
                const scrolled = window.pageYOffset;
                const hero = document.querySelector('.hero');
                const scrollIndicator = document.querySelector('.scroll-indicator');

                const parallax = scrolled * 0.3;
                hero.style.transform = `translateY(${parallax}px)`;

                if (scrolled > 50) {
                    scrollIndicator.style.opacity = '0';
                } else {
                    scrollIndicator.style.opacity = '1';
                }
            });

            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                        entry.target.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
                    }
                });
            }, observerOptions);

            document.querySelectorAll('.feature-card').forEach(card => {
                observer.observe(card);
            });
        });
    </script>
</body>
</html>